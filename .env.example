# CrossFit Blaze — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env or real secrets.

# upload-post.com API key (used by scripts/post-to-instagram.{js,py},
# scripts/autonomous-instagram-post.sh, scripts/test-upload-post-api.sh,
# scripts/instagram-auto-post-7am.sh)
UPLOAD_POST_API_KEY=your-upload-post-api-key-here

# Instagram account credentials (used by scripts/instagram_automation.py)
INSTAGRAM_USERNAME=crossfitblaze
INSTAGRAM_PASSWORD=your-instagram-password-here
